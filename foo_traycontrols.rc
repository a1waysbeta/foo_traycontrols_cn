#include "resource.h"
#include <windows.h>

// Tray icon
IDI_TRAY_ICON           ICON    "foobar2000_105.ico"

// Internet radio icon for popup notifications
IDI_RADIO_ICON          ICON    "iradio.ico"

// Control panel icons
IDI_PLAY_ICON           ICON    "play_icon.ico"
IDI_PAUSE_ICON          ICON    "pause_icon.ico"
IDI_PREVIOUS_ICON       ICON    "previous_icon.ico"
IDI_NEXT_ICON           ICON    "next_icon.ico"

// PNG version as binary resource (fallback)
IDR_TRAY_PNG            RCDATA  "tray_icon.png"

// Preferences dialog with tabs
IDD_PREFERENCES_TRAY DIALOGEX 0, 0, 300, 300
STYLE DS_SETFONT | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    // Tab control at the top
    CONTROL         "", IDC_TAB_CONTROL, "SysTabControl32", 0, 7, 7, 286, 286

    // === General Tab Controls (shown by default) ===

    // Display Format
    GROUPBOX        "显示格式", IDC_DISPLAY_FORMAT_GROUP, 12, 26, 272, 50
    LTEXT           "第一行：", IDC_LINE1_FORMAT_LABEL, 20, 40, 35, 12
    EDITTEXT        IDC_LINE1_FORMAT_EDIT, 59, 38, 217, 14, ES_AUTOHSCROLL
    LTEXT           "第二行：", IDC_LINE2_FORMAT_LABEL, 20, 56, 35, 12
    EDITTEXT        IDC_LINE2_FORMAT_EDIT, 59, 54, 217, 14, ES_AUTOHSCROLL

    CONTROL         "始终最小化到系统托盘", IDC_ALWAYS_MINIMIZE_TO_TRAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 84, 200, 10
    CONTROL         "启用后，点击最小化按钮将直接把 foobar2000 最小化到系统托盘。", IDC_STATIC_MINIMIZE_HELP, "Static", SS_LEFT | SS_NOPREFIX, 15, 96, 270, 8
    CONTROL         "在托盘图标上滚动鼠标滚轮可调整音量。", IDC_STATIC_WHEEL_HELP, "Static", SS_LEFT | SS_NOPREFIX, 15, 107, 270, 8
    CONTROL         "双击操作", IDC_DOUBLE_CLICK_ACTIONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 123, 200, 10
    CONTROL         "双击托盘图标可打开或关闭 foobar2000 主窗口。", IDC_STATIC_DBLCLICK_HELP, "Static", SS_LEFT | SS_NOPREFIX, 15, 135, 270, 8
    CONTROL         "在歌曲切换时显示弹出通知", IDC_SHOW_POPUP_NOTIFICATION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 152, 135, 10
    PUSHBUTTON      "预览", IDC_PREVIEW_POPUP_BTN, 152, 150, 42, 13, WS_TABSTOP
    LTEXT           "位置：", IDC_POPUP_POSITION_LABEL, 15, 170, 30, 10
    COMBOBOX        IDC_POPUP_POSITION_COMBO, 47, 168, 60, 120, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "显示时长：", IDC_POPUP_DURATION_LABEL, 117, 170, 50, 10
    COMBOBOX        IDC_POPUP_DURATION_COMBO, 169, 168, 60, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "禁用迷你播放器", IDC_DISABLE_MINIPLAYER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 189, 200, 10
    CONTROL         "启用后，迷你面板将锁定当前位置（贴边/悬浮），无法拖动。", IDC_STATIC_MINIPLAYER_HELP, "Static", SS_LEFT | SS_NOPREFIX, 15, 201, 270, 8

    // Slide-to-Side Options
    CONTROL         "禁用贴边隐藏", IDC_DISABLE_SLIDE_TO_SIDE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 216, 100, 10
    LTEXT           "隐藏动画：", IDC_SLIDE_DURATION_LABEL, 15, 232, 50, 10
    COMBOBOX        IDC_SLIDE_DURATION_COMBO, 67, 230, 80, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    // === Appearance Tab Controls (hidden initially) ===
    LTEXT           "主题模式：", IDC_THEME_MODE_LABEL, 15, 32, 85, 12
    COMBOBOX        IDC_THEME_MODE_COMBO, 105, 30, 110, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "专辑封面：", IDC_COVER_ARTWORK_LABEL, 15, 52, 85, 12
    COMBOBOX        IDC_COVER_ARTWORK_COMBO, 105, 50, 110, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "封面边距：", IDC_COVER_MARGIN_LABEL, 15, 72, 85, 12
    COMBOBOX        IDC_COVER_MARGIN_COMBO, 105, 70, 110, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "封面样式：", IDC_COVER_STYLE_LABEL, 15, 92, 85, 12
    COMBOBOX        IDC_COVER_STYLE_COMBO, 105, 90, 110, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "背景样式：", IDC_BACKGROUND_STYLE_LABEL, 15, 112, 85, 12
    COMBOBOX        IDC_BACKGROUND_STYLE_COMBO, 105, 110, 110, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "迷你播放器边框：", IDC_MINIPLAYER_BORDER_LABEL, 15, 132, 85, 12
    COMBOBOX        IDC_MINIPLAYER_BORDER_COMBO, 105, 130, 110, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "滚动速度：", IDC_TICKER_SPEED_LABEL, 15, 152, 85, 12
    COMBOBOX        IDC_TICKER_SPEED_COMBO, 105, 150, 110, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "进度条强调色：", IDC_PROGRESS_ACCENT_LABEL, 15, 172, 85, 12
    PUSHBUTTON      "", IDC_PROGRESS_ACCENT_BTN, 105, 170, 20, 14, BS_OWNERDRAW | WS_TABSTOP

    CONTROL         "显示音量 OSD", IDC_SHOW_VOLUME_FEEDBACK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 195, 85, 10
    PUSHBUTTON      "", IDC_VOLUME_OSD_COLOR_BTN, 105, 193, 20, 14, BS_OWNERDRAW | WS_TABSTOP

    // === Icons Tab Controls (hidden initially) ===
    LTEXT           "悬停圆形高亮背景：", IDC_HOVER_CIRCLES_LABEL, 15, 32, 85, 12
    COMBOBOX        IDC_HOVER_CIRCLES_COMBO, 105, 30, 110, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "播放/暂停按钮图标样式：", IDC_ALTERNATIVE_ICONS_LABEL, 15, 54, 85, 12
    COMBOBOX        IDC_ALTERNATIVE_ICONS_COMBO, 105, 52, 110, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP


    // === MiniPlayer Tab Controls (hidden initially) ===
    
    // Undocked Mode Section
    GROUPBOX        "悬浮模式", IDC_MINIPLAYER_UNDOCKED_GROUP, 15, 30, 270, 70
    LTEXT           "尺寸预设：", IDC_MINIPLAYER_UNDOCKED_PRESET_LABEL, 25, 46, 60, 10
    COMBOBOX        IDC_MINIPLAYER_UNDOCKED_PRESET_COMBO, 90, 44, 175, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "宽度（像素）：", IDC_MINIPLAYER_UNDOCKED_WIDTH_LABEL, 25, 70, 60, 10
    EDITTEXT        IDC_MINIPLAYER_UNDOCKED_WIDTH_EDIT, 90, 68, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "高度（像素）：", IDC_MINIPLAYER_UNDOCKED_HEIGHT_LABEL, 160, 70, 50, 10
    EDITTEXT        IDC_MINIPLAYER_UNDOCKED_HEIGHT_EDIT, 215, 68, 50, 14, ES_NUMBER | WS_TABSTOP

    // Compact Mode Section
    GROUPBOX        "紧凑模式", IDC_MINIPLAYER_COMPACT_GROUP, 15, 110, 270, 70
    LTEXT           "尺寸预设：", IDC_MINIPLAYER_COMPACT_PRESET_LABEL, 25, 126, 60, 10
    COMBOBOX        IDC_MINIPLAYER_COMPACT_PRESET_COMBO, 90, 124, 175, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "宽度（像素）：", IDC_MINIPLAYER_COMPACT_WIDTH_LABEL, 25, 150, 60, 10
    EDITTEXT        IDC_MINIPLAYER_COMPACT_WIDTH_EDIT, 90, 148, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "高度（像素）：", IDC_MINIPLAYER_COMPACT_HEIGHT_LABEL, 160, 150, 50, 10
    EDITTEXT        IDC_MINIPLAYER_COMPACT_HEIGHT_EDIT, 215, 148, 50, 14, ES_NUMBER | WS_TABSTOP

    // Expanded Artwork Mode Section
    GROUPBOX        "扩展封面模式", IDC_MINIPLAYER_EXPANDED_GROUP, 15, 190, 270, 70
    LTEXT           "尺寸预设：", IDC_MINIPLAYER_EXPANDED_PRESET_LABEL, 25, 206, 60, 10
    COMBOBOX        IDC_MINIPLAYER_EXPANDED_PRESET_COMBO, 90, 204, 175, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "正方形尺寸（像素）：", IDC_MINIPLAYER_EXPANDED_SIZE_LABEL, 25, 230, 75, 10
    EDITTEXT        IDC_MINIPLAYER_EXPANDED_SIZE_EDIT, 105, 228, 60, 14, ES_NUMBER | WS_TABSTOP


    // === Fonts Tab Controls (hidden initially) ===
    
    // Docked Control Panel section
    LTEXT           "停靠模式", IDC_DOCKED_TITLE, 15, 30, 120, 10
    LTEXT           "艺术家字体：", IDC_DOCKED_ARTIST_LABEL, 25, 45, 55, 10
    EDITTEXT        IDC_DOCKED_ARTIST_DISPLAY, 75, 43, 130, 14, ES_READONLY | WS_BORDER
    PUSHBUTTON      "选择...", IDC_DOCKED_ARTIST_SELECT, 215, 42, 50, 16
    LTEXT           "标题字体：", IDC_DOCKED_TRACK_LABEL, 25, 63, 55, 10
    EDITTEXT        IDC_DOCKED_TRACK_DISPLAY, 75, 61, 130, 14, ES_READONLY | WS_BORDER
    PUSHBUTTON      "选择...", IDC_DOCKED_TRACK_SELECT, 215, 60, 50, 16

    // Undocked Control Panel section
    LTEXT           "悬浮模式", IDC_UNDOCKED_TITLE, 15, 85, 120, 10
    LTEXT           "艺术家字体：", IDC_UNDOCKED_ARTIST_LABEL, 25, 100, 55, 10
    EDITTEXT        IDC_UNDOCKED_ARTIST_DISPLAY, 75, 98, 130, 14, ES_READONLY | WS_BORDER
    PUSHBUTTON      "选择...", IDC_UNDOCKED_ARTIST_SELECT, 215, 97, 50, 16
    LTEXT           "标题字体：", IDC_UNDOCKED_TRACK_LABEL, 25, 118, 55, 10
    EDITTEXT        IDC_UNDOCKED_TRACK_DISPLAY, 75, 116, 130, 14, ES_READONLY | WS_BORDER
    PUSHBUTTON      "选择...", IDC_UNDOCKED_TRACK_SELECT, 215, 115, 50, 16

    // Expanded Control Panel section
    LTEXT           "扩展封面模式", IDC_EXPANDED_TITLE, 15, 140, 120, 10
    LTEXT           "艺术家字体：", IDC_EXPANDED_ARTIST_LABEL, 25, 155, 55, 10
    EDITTEXT        IDC_EXPANDED_ARTIST_DISPLAY, 75, 153, 130, 14, ES_READONLY | WS_BORDER
    PUSHBUTTON      "选择...", IDC_EXPANDED_ARTIST_SELECT, 215, 152, 50, 16
    LTEXT           "标题字体：", IDC_EXPANDED_TRACK_LABEL, 25, 173, 55, 10
    EDITTEXT        IDC_EXPANDED_TRACK_DISPLAY, 75, 171, 130, 14, ES_READONLY | WS_BORDER
    PUSHBUTTON      "选择...", IDC_EXPANDED_TRACK_SELECT, 215, 170, 50, 16

    // Compact Control Panel section
    LTEXT           "紧凑模式", IDC_COMPACT_TITLE, 15, 195, 120, 10
    LTEXT           "艺术家字体：", IDC_COMPACT_ARTIST_LABEL, 25, 210, 55, 10
    EDITTEXT        IDC_COMPACT_ARTIST_DISPLAY, 75, 208, 130, 14, ES_READONLY | WS_BORDER
    PUSHBUTTON      "选择...", IDC_COMPACT_ARTIST_SELECT, 215, 207, 50, 16
    LTEXT           "标题字体：", IDC_COMPACT_TRACK_LABEL, 25, 228, 55, 10
    EDITTEXT        IDC_COMPACT_TRACK_DISPLAY, 75, 226, 130, 14, ES_READONLY | WS_BORDER
    PUSHBUTTON      "选择...", IDC_COMPACT_TRACK_SELECT, 215, 225, 50, 16

    // Timer Display section (shared across Docked, Undocked, Compact)
    LTEXT           "时间显示", IDC_TIMER_TITLE, 15, 250, 120, 10
    LTEXT           "时间字体：", IDC_TIMER_FONT_LABEL, 25, 260, 45, 10
    EDITTEXT        IDC_TIMER_FONT_DISPLAY, 75, 258, 130, 14, ES_READONLY | WS_BORDER
    PUSHBUTTON      "选择...", IDC_TIMER_FONT_SELECT, 215, 257, 50, 16

END
